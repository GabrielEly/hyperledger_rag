# Hyperledger RAG API - Variáveis de Ambiente

# ===== AMBIENTE =====
ENVIRONMENT=development
DEBUG=true

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
WORKERS=4

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ===== AUTENTICAÇÃO =====
API_KEY_REQUIRED=false
# Para produção, copie 2 chaves diferentes separadas por vírgula
API_KEYS=sk-demo-key-123,sk-demo-key-456

# ===== RAG CONFIGURATION =====
RAG_MODEL_ID=TinyLlama/TinyLlama-1.1B-Chat-v1.0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-l6-v2
VECTOR_DB_PATH=faiss_index_v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RETRIEVAL_K=4

# ===== LLM PARAMETERS =====
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_TOP_K=50
LLM_TOP_P=0.95
LLM_DO_SAMPLE=true

# ===== CACHE =====
CACHE_BACKEND=memory
# Opções: memory
CACHE_ENABLED=true
CACHE_TTL_RESPONSES=86400
CACHE_TTL_EMBEDDINGS=2592000
CACHE_MAX_SIZE=10000


# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=logs/rag_api.log

# ===== WEBSOCKET =====
WEBSOCKET_ENABLED=true
WEBSOCKET_PING_INTERVAL=30

# ===== CRAWLING =====
CRAWLER_TARGET_URL=https://hyperledger-fabric.readthedocs.io/en/latest/
CRAWLER_MAX_PAGES=100
CRAWLER_TIMEOUT=30
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)

# ===== MONITORING =====
PROMETHEUS_ENABLED=false
